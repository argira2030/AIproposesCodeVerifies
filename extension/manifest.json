{
  "manifest_version": 3,
  "name": "AIproposesCodeVerifies",
  "version": "1.1.0",
  "description": "La IA propone. El código verifica. Tú decides. Comprobación local de los datos que has decidido proteger.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "AIproposesCodeVerifies" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "contextMenus"],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self'"
  }
}
